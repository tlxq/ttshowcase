# What the server code reads. Live values are in Vercel (Sensitive); none are needed to build or run `mise run check`.
# To run the real API locally: `vercel env pull .env.local` (git ignores .env*, except this file).

# /next: the key that opens the new site before it goes live (middleware.ts). Empty = /next closed to everyone.
PREVIEW_KEY=

# Tags and the mail form (api/tags.ts, api/contact.ts). Table: tools/tags/schema.sql.
DATABASE_URL=
# Signs Tom's review links and scrambles visitor addresses; at least 32 characters.
TAG_SECRET=
# Tom's own wall (api/admin.ts).
ADMIN_KEY=

# Mail through Resend: the key, Tom's address, and the sender on ttdevs.com.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
